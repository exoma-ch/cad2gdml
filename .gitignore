# Ignore all output folders
/output/*
*.gdml
/log*.txt
*.csv
*.png
*.step

# But always keep .gitkeep files everywhere
!*.gitkeep
!/output/**/*.gitkeep

# Ignore everything inside 'STEP files'
/data/STEPfiles/*

# (Optional) Ignore Python cache and backup files
__pycache__/
*.pyc
*~

# Virtual environment
.venv/
venv/
env/

# Claude Code personal settings (per-user, not committed)
.claude/settings.local.json

# Coverage reports
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# Don't ignore anything in tests folder (except cache files)
!tests/
!tests/**
# But still ignore cache files in tests
tests/**/__pycache__/
tests/**/*.pyc
# Run logs
logs/
