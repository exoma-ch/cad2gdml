# Ignore all output folders
/output/gdml/*
/output/analysis/*
/output/properties/*
/log*.txt
/*.csv

# But always keep .gitkeep files everywhere
!*.gitkeep
!/output/**/*.gitkeep

# Ignore everything inside 'STEP files'
/data/STEPfiles/*

# (Optional) Ignore Python cache and backup files
__pycache__/
*.pyc
*~
