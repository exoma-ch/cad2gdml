FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglx-mesa0 \
    libxrender1 \
    libxext6 \
    libglib2.0-0 \
    libsm6 \
    libx11-6 \
    libxcb1 \
    libxkbcommon0 \
    wget \
    fuse \
    ca-certificates \
    && wget -q -O /tmp/FreeCAD.AppImage \
        https://github.com/FreeCAD/FreeCAD/releases/download/1.0.1/FreeCAD_1.0.1-conda-Linux-x86_64-py311.AppImage \
    && chmod +x /tmp/FreeCAD.AppImage \
    && cd /usr/local/bin && /tmp/FreeCAD.AppImage --appimage-extract \
    && rm /tmp/FreeCAD.AppImage \
    && apt-get purge -y wget fuse \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
COPY requirements.txt requirements-test.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt -r requirements-test.txt

# See Containerfile.slim for why LD_LIBRARY_PATH is intentionally not set.
ENV PYTHONPATH="/usr/local/bin/squashfs-root/usr/lib"

VOLUME ["/mnt/guimesh"]
WORKDIR /mnt/guimesh

CMD ["bash"]
