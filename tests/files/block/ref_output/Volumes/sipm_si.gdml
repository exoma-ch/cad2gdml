<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
 <define>
 <position name="sipm_si_v0" unit="mm" x="24.65" y="1.0" z="8.200000000000003"/>
 <position name="sipm_si_v1" unit="mm" x="24.65" y="2.0" z="8.200000000000003"/>
 <position name="sipm_si_v2" unit="mm" x="8.350000000000001" y="2.0" z="8.200000000000003"/>
 <position name="sipm_si_v3" unit="mm" x="8.350000000000001" y="1.0" z="8.200000000000003"/>
 <position name="sipm_si_v4" unit="mm" x="24.65" y="2.0" z="0.10000000000000246"/>
 <position name="sipm_si_v5" unit="mm" x="24.65" y="1.0" z="0.10000000000000246"/>
 <position name="sipm_si_v6" unit="mm" x="8.350000000000001" y="2.0" z="0.10000000000000135"/>
 <position name="sipm_si_v7" unit="mm" x="8.350000000000001" y="1.0" z="0.10000000000000135"/>
 </define>

 <solids>
 <tessellated aunit="deg" lunit="mm" name="sipm_si_solid">
 <triangular vertex1="sipm_si_v0" vertex2="sipm_si_v1" vertex3="sipm_si_v2"/>
 <triangular vertex1="sipm_si_v0" vertex2="sipm_si_v2" vertex3="sipm_si_v3"/>
 <triangular vertex1="sipm_si_v1" vertex2="sipm_si_v0" vertex3="sipm_si_v4"/>
 <triangular vertex1="sipm_si_v4" vertex2="sipm_si_v0" vertex3="sipm_si_v5"/>
 <triangular vertex1="sipm_si_v6" vertex2="sipm_si_v4" vertex3="sipm_si_v7"/>
 <triangular vertex1="sipm_si_v7" vertex2="sipm_si_v4" vertex3="sipm_si_v5"/>
 <triangular vertex1="sipm_si_v3" vertex2="sipm_si_v2" vertex3="sipm_si_v6"/>
 <triangular vertex1="sipm_si_v3" vertex2="sipm_si_v6" vertex3="sipm_si_v7"/>
 <triangular vertex1="sipm_si_v1" vertex2="sipm_si_v4" vertex3="sipm_si_v6"/>
 <triangular vertex1="sipm_si_v1" vertex2="sipm_si_v6" vertex3="sipm_si_v2"/>
 <triangular vertex1="sipm_si_v5" vertex2="sipm_si_v0" vertex3="sipm_si_v7"/>
 <triangular vertex1="sipm_si_v7" vertex2="sipm_si_v0" vertex3="sipm_si_v3"/>
 </tessellated>
 <box lunit="mm" name="worldsolid" x="1000" y="1000" z="1000"/>
 </solids>
 <structure>
 <volume name="sipm_si">
 <materialref ref="G4_Si"/>
 <solidref ref="sipm_si_solid"/>
 </volume>
 </structure>
 <setup name="Default" version="1.0">
 <world ref="sipm_si"/>
 </setup>
</gdml>