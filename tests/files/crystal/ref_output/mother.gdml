<?xml version="1.0" encoding="UTF-8" ?>
<gdml xmlns:gdml="../schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schema/gdml.xsd" >
<!--
  Geometry Transformation Information:
  Geometry uses original CAD coordinates (no translation applied).
  For detailed transformation information, see geometry_transform.json in the output directory.
-->
<define>
<position name="geometry_offset" x="-0.0" y="-0.0" z="-0.0" unit="m"/>
<rotation name="identity" x="0" y="0" z="0"/>
</define>
<materials>
<element name="Vacuum_el"  formula="Hv" Z="1">
<atom value="1.008"/>
</element> 
<material name="Vacuum">
<D value="0.0000000000000000000001" unit="mg/cm3"/>
<fraction n="1.0" ref="Vacuum_el"/>
</material>
<material name="LYSO" state="solid">
<D unit="g/cm3" value="7.1"/>
<fraction n="0.7143" ref="G4_Lu"/>
<fraction n="0.0403" ref="G4_Y"/>
<fraction n="0.0637" ref="G4_Si"/>
<fraction n="0.1814" ref="G4_O"/>
<fraction n="0.0003" ref="G4_Ce"/>
</material>
</materials>
<solids>
<box name="WorldBox" x="0.0055650000000000005" y="0.0525" z="0.004147500000000001" lunit="m"/>
</solids>
<structure>
<volume name="World">
<materialref ref="Vacuum"/>
<solidref ref="WorldBox"/>
<physvol>
<file name="Volumes/_detector_lyso_.gdml"/>
<positionref ref="geometry_offset"/>
<rotationref ref="identity"/>
</physvol>
</volume>
</structure>
<setup name="Default" version="1.0">
<world ref="World"/>
</setup>
</gdml>